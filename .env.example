# Fabric Unified Permission Hub
APP_NAME=Fabric Unified Permission Hub
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
SECRET_KEY=change-me

# Where YAML connector configs are stored
CONFIGS_DIR=./configs
AUDIT_DIR=./audits
# SQLite database directory (pairings, jobs, diff snapshots, audit, approvals)
DATA_DIR=./data

# Optional: Azure Service Principal used by Fabric/Graph clients
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default pointers for the hub UI (used when no ?workspace_url= is provided)
# Databricks workspace URL, e.g. https://adb-<id>.<region>.azuredatabricks.net
DBX_WORKSPACE_URL=
# Fabric workspace GUID
FABRIC_WORKSPACE_ID=
# SQL warehouse id — required to materialize ABAC policies (read governed tags)
DBX_WAREHOUSE_ID=

# Background re-scan interval in minutes (0 = disabled). When > 0, every pairing
# is re-diffed periodically and a drift snapshot is recorded.
SCAN_INTERVAL_MINUTES=0

# Require an approval before any real (non-dry-run) apply (true/false).
REQUIRE_APPROVAL=false

# --- Authentication (Entra SSO) — disabled by default ---
AUTH_ENABLED=false
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_TENANT_ID=
AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Comma-separated emails mapped to roles (everyone authenticated is a viewer)
AUTH_ADMIN_EMAILS=
AUTH_APPROVER_EMAILS=

# --- Optional: only used by the helper scripts in scripts/ ---
# Unity Catalog catalog name to probe/seed against (use a disposable catalog)
UC_CATALOG=
# UPN of a test principal that exists in your tenant
UC_TEST_PRINCIPAL=
# Fabric item GUID (e.g. a mirrored catalog) for the OneLake DAR probes
FABRIC_ITEM_ID=
