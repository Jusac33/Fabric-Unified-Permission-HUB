# Required — Key Vault used for Tier-2 secrets (Snowflake creds, Policy Weaver / OneSync API keys)
KEY_VAULT_URI=https://<your-kv>.vault.azure.net/

# When running in Azure (CI, AKS, Container Apps), set this to force ManagedIdentityCredential
RUNNING_IN_AZURE=0

# Client ID of the user-assigned managed identity when RUNNING_IN_AZURE=1
AZURE_CLIENT_ID=

# Run-level overrides (take precedence over config/settings.yaml)
DRY_RUN=true
SYNC_DIRECTION=source_to_fabric

# Optional — Azure Monitor workspace for audit ingestion
LOG_ANALYTICS_WORKSPACE_ID=
